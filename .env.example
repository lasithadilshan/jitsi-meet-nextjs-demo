# GitHub Pages base path (set to your repository name for GitHub Pages deployment)
# Leave empty for local development
# Example: /jitsi-meet-demo
NEXT_PUBLIC_BASE_PATH=

# Jitsi Meet server domain (defaults to fairmeeting.net which requires no login or moderator)
# Options: fairmeeting.net, meet.jit.si (requires moderator login), or your self-hosted Jitsi domain
NEXT_PUBLIC_JITSI_DOMAIN=fairmeeting.net

